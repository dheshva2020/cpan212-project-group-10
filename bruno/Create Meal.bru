meta {
  name: Create Meal
  type: http
  seq: 3
}

post {
  url: http://localhost:4000/api/meals
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Pasta",
    "category": "Dinner",
    "ingredients": ["pasta", "tomato"],
    "instructions": "Cook pasta and serve."
  }
}

tests {
  test("Returns 201", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().name).to.equal("Pasta");
  });
}