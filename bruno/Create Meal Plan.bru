meta {
  name: Create Meal Plan
  type: http
  seq: 8
}

post {
  url: http://localhost:4000/api/meal-plans
  body: json
  auth: inherit
}

body:json {
  {
    "userId": "user-1",
    "name": "M4 Test Meal Plan",
    "date": "2026-11-25",
    "notes": "Testing MongoDB integration"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("mealPlanId", res.getBody().id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}